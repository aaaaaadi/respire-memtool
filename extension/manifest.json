{
  "manifest_version": 3,
  "name": "memTools 记忆捕获",
  "version": "0.2.0",
  "description": "把网页选中文字保存到本机 memTools（rsrs 记忆库）",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "memTools 记忆捕获"
  },
  "icons": {
    "128": "icon128.png"
  }
}
